{
  "query": "\n-- Todas as compras por galão\nSELECT gallon_number, liters_purchased, ROUND(liters_purchased/100, 2) as liters_L, amount_paid, purchased_at, notes\nFROM fuel_purchases\nORDER BY gallon_number, purchased_at;\n\n-- Todos os abastecimentos ativos por galão (fuel_records sem containers)\nSELECT fr.id, fr.gallon_number, fr.liters, ROUND(fr.liters/100, 2) as liters_L, fr.client_name, fr.payment_status, fr.created_at\nFROM fuel_records fr\nWHERE NOT EXISTS (SELECT 1 FROM fuel_record_containers frc WHERE frc.fuel_record_id = fr.id)\nORDER BY fr.gallon_number, fr.created_at;\n\n-- Todos os containers ativos\nSELECT frc.fuel_record_id, frc.gallon_number, frc.liters_used, ROUND(frc.liters_used/100, 2) as liters_L\nFROM fuel_record_containers frc\nORDER BY frc.gallon_number;\n",
