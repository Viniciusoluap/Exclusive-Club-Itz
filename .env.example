# ─── Obrigatório ───────────────────────────────────────────────────────────────

# Segredo para assinar os cookies de sessão JWT (use uma string longa e aleatória)
JWT_SECRET=troque-por-uma-string-secreta-longa

# URL de conexão com o banco MySQL
DATABASE_URL=mysql://usuario:senha@host:3306/exclusive_club

# ─── Setup inicial do administrador ────────────────────────────────────────────
# Defina essas variáveis na PRIMEIRA inicialização para criar o admin.
# Após o primeiro login, você pode remover ou deixar em branco.
# Se estiver definido, a senha do admin será ATUALIZADA a cada reinicialização.

INITIAL_ADMIN_EMAIL=admin@seudominio.com
INITIAL_ADMIN_PASSWORD=troque-por-uma-senha-forte
INITIAL_ADMIN_NAME=Administrador

# ─── Identificador da aplicação (opcional) ──────────────────────────────────────
# Usado para identificar tokens JWT. Pode ser qualquer string fixa.
APP_ID=exclusive-club

# ─── Integração Asaas (gateway de pagamento) ───────────────────────────────────
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ─── AWS S3 (armazenamento de arquivos) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── Email SMTP ────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── IA (Claude / Forge) ───────────────────────────────────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
