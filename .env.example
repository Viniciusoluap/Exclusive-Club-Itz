# ─── Obrigatório (Manus fornece automaticamente) ───────────────────────────────

# ID do app no Manus (gerado na criação do projeto)
VITE_APP_ID=seu-app-id-do-manus

# URL do portal OAuth do Manus (frontend)
VITE_OAUTH_PORTAL_URL=https://oauth.manus.computer

# URL do servidor OAuth do Manus (backend)
OAUTH_SERVER_URL=https://oauth-server.manus.computer

# OpenID do dono/admin principal (seu openId do Manus)
OWNER_OPEN_ID=seu-open-id-do-manus

# ─── Segurança ─────────────────────────────────────────────────────────────────

# Segredo para assinar os cookies de sessão JWT
JWT_SECRET=troque-por-uma-string-secreta-longa

# Chave dedicada para criptografar os valores da tabela `system_settings`
# em repouso (AES-256-CBC), incluindo a chave da API do Asaas.
# RECOMENDADA: se não definida, o sistema faz fallback (INSEGURO) para JWT_SECRET
# e emite um aviso. Configure uma string própria (>= 32 chars). Gere com:
# `openssl rand -base64 48`
# ATENÇÃO: ao definir esta variável pela primeira vez num ambiente que já tinha
# settings criptografados via JWT_SECRET, os valores antigos falharão ao
# descriptografar até serem RE-SALVOS (ex.: reabrir o painel Settings e salvar a
# chave do Asaas novamente) para re-criptografar com a nova chave.
SETTINGS_ENCRYPTION_KEY=

# Chave de criptografia dos backups (AES-256-GCM, at-rest).
# OBRIGATÓRIA: sem ela o backup é abortado (nunca gera artefato sem criptografia).
# Use pelo menos 32 caracteres de entropia. Gere com: `openssl rand -base64 48`
# ATENÇÃO: guarde esta chave fora dos backups. Perdê-la torna os backups irrecuperáveis.
BACKUP_ENCRYPTION_KEY=

# ─── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=mysql://usuario:senha@host:3306/exclusive_club

# ─── Integração Asaas (gateway de pagamento) ───────────────────────────────────
# ASAAS_API_KEY é um OVERRIDE opcional. A fonte oficial da chave continua sendo o
# painel admin (System Settings), que grava criptografado no banco. Se esta variável
# for definida e não-vazia, ela tem prioridade sobre o valor do banco (migração
# gradual para fora do banco). Se ficar vazia, o comportamento é o atual: lê do banco.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ─── AWS S3 (armazenamento de arquivos) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── Email SMTP ────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── IA (Claude / Forge) ───────────────────────────────────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

NODE_ENV=development
