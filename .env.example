# ─── Obrigatório (Manus fornece automaticamente) ───────────────────────────────

# ID do app no Manus (gerado na criação do projeto)
VITE_APP_ID=seu-app-id-do-manus

# URL do portal OAuth do Manus (frontend)
VITE_OAUTH_PORTAL_URL=https://oauth.manus.computer

# URL do servidor OAuth do Manus (backend)
OAUTH_SERVER_URL=https://oauth-server.manus.computer

# OpenID do dono/admin principal (seu openId do Manus)
OWNER_OPEN_ID=seu-open-id-do-manus

# ─── Segurança ─────────────────────────────────────────────────────────────────

# Segredo para assinar os cookies de sessão JWT
JWT_SECRET=troque-por-uma-string-secreta-longa

# Chave de criptografia dos backups (AES-256-GCM, at-rest).
# OBRIGATÓRIA: sem ela o backup é abortado (nunca gera artefato sem criptografia).
# Use pelo menos 32 caracteres de entropia. Gere com: `openssl rand -base64 48`
# ATENÇÃO: guarde esta chave fora dos backups. Perdê-la torna os backups irrecuperáveis.
BACKUP_ENCRYPTION_KEY=

# ─── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=mysql://usuario:senha@host:3306/exclusive_club

# ─── Integração Asaas (gateway de pagamento) ───────────────────────────────────
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# ─── AWS S3 (armazenamento de arquivos) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── Email SMTP ────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── IA (Claude / Forge) ───────────────────────────────────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# === AIOX Variables (added 2026-07-18) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=5.3.0
